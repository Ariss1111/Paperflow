# Product name shown throughout the UI.
NEXT_PUBLIC_APP_NAME=Paperflow

# Where uploads and job outputs are written. Defaults to <os tmpdir>/paperflow.
# DATA_DIR=/var/lib/paperflow

# How long uploaded files and results are kept before automatic deletion (minutes).
RETENTION_MINUTES=60

# Upload limits.
MAX_UPLOAD_MB=200
MAX_FILES_PER_REQUEST=30

# Processing limits.
JOB_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=300
CONVERSION_TIMEOUT_SECONDS=180

# Rate limiting (requests per minute, per browser session).
RATE_LIMIT_UPLOADS_PER_MIN=60
RATE_LIMIT_JOBS_PER_MIN=40

# LibreOffice executable for Office -> PDF conversions. When unset, Paperflow looks in
# .tools/libreoffice (see scripts/fetch-libreoffice.ps1), standard install locations and PATH.
# SOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe"

# OCR language data. eng ships with the app (@tesseract.js-data/eng). For other
# languages put <lang>.traineddata(.gz) files in this directory and list them below.
# OCR_LANG_PATH=./.tools/tessdata
OCR_LANGUAGES=eng

# Optional ClamAV daemon for malware scanning of uploads (host:port). Uploads are rejected
# if a configured scanner reports a detection or is unreachable.
# CLAMAV_ADDRESS=127.0.0.1:3310
