# Product name shown throughout the UI.
NEXT_PUBLIC_APP_NAME=Pagelyt
# Shown on /contact. Leave empty until you have an address to publish.
# CONTACT_EMAIL=hello@example.com

# Where uploads and job outputs are written. Defaults to <os tmpdir>/paperflow.
# DATA_DIR=/var/lib/paperflow

# How long uploaded files and results are kept before automatic deletion (minutes).
RETENTION_MINUTES=60

# Upload limits.
MAX_UPLOAD_MB=200
MAX_FILES_PER_REQUEST=30

# Processing limits.
JOB_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=300
CONVERSION_TIMEOUT_SECONDS=180

# Rate limiting (requests per minute, per browser session).
RATE_LIMIT_UPLOADS_PER_MIN=60
RATE_LIMIT_JOBS_PER_MIN=40

# LibreOffice executable for Office -> PDF conversions. When unset, Paperflow looks in
# .tools/libreoffice (see scripts/fetch-libreoffice.ps1), standard install locations and PATH.
# SOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe"

# OCR language data. eng ships with the app (@tesseract.js-data/eng). For other
# languages put <lang>.traineddata(.gz) files in this directory and list them below.
# OCR_LANG_PATH=./.tools/tessdata
OCR_LANGUAGES=eng

# Optional ClamAV daemon for malware scanning of uploads (host:port). Uploads are rejected
# if a configured scanner reports a detection or is unreachable.
# CLAMAV_ADDRESS=127.0.0.1:3310

# Accounts and saved documents. Production: Postgres + S3-compatible storage (see DEPLOY.md).
# Without DATABASE_URL / S3_*, everything is stored inside DATA_DIR (fine for one computer).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# S3_BUCKET=pagelyt-documents
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# APP_URL=https://your-site.example          # used in emails and for Google sign-in
# AUTH_SECRET=                               # required in production: long random string
# Email (confirmations, password resets) through any SMTP server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Pagelyt <you@example.com>
# DEV_MAILBOX=1                              # no SMTP: show emails at /dev/mail (never on a public site)
# Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Limits
# STORAGE_QUOTA_MB=1024
# MAX_DOCUMENT_MB=100
# VERSIONS_KEPT=10
# TRASH_DAYS=30
# SESSION_DAYS=30
# UNVERIFIED_ACCOUNT_DAYS=7
# SIGNED_URL_SECONDS=300
# RATE_LIMIT_SIGNUPS_PER_MIN=5

# AI Workspace (chat, summaries, translation, extraction, change explanations) uses Anthropic's Claude API.
# Without a key it shows "Needs setup" and sends nothing. Documents are sent to Anthropic only when
# someone uses an AI feature, after agreeing to it once. Document comparison never needs AI.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=anthropic            # "none" switches AI off even with a key
# AI_MODEL=claude-opus-5-5
# Cost safeguards (per visitor per day unless noted; blank = default)
# AI_DAILY_REQUESTS=30
# AI_DAILY_TOKENS=1500000
# AI_MAX_FILE_MB=25
# AI_MAX_PAGES=300
# AI_GLOBAL_DAILY_REQUESTS=2000    # whole server
# RATE_LIMIT_AI_PER_MIN=12
# Allowances for a future Pro plan (lib/server/ai/config.ts → planFor decides who gets it)
# AI_PRO_DAILY_REQUESTS=300
# AI_PRO_DAILY_TOKENS=15000000
# AI_PRO_MAX_FILE_MB=30
# AI_PRO_MAX_PAGES=1000
